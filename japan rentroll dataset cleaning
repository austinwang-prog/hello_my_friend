# 3 Date conversion
# Create a fresh copy for visualization
viz_df = cleaned_df.copy()

# Define date columns
date_columns = ['Lease Start Date', 'Lease Expiry Date', 'Lease Rent Payment Start Date']

# Step 1: Clean date strings by removing time components
for col in date_columns:
   # Remove time component if present (anything after space)
   if viz_df[col].dtype == object:  # Check if it's string/object column
       viz_df[col] = viz_df[col].astype(str).str.split(' ').str[0]
       print(f"Removed time component from {col}")

# Step 2: Convert to datetime
for col in date_columns:
   viz_df[col] = pd.to_datetime(viz_df[col], errors='coerce')
   
   # Check if any couldn't be converted
   null_count = viz_df[col].isnull().sum()
   if null_count > 0:
       print(f"Warning: {null_count} values in {col} couldn't be converted to datetime")

# Step 3: Check date ranges and handle outliers
for col in date_columns:
   min_date = viz_df[col].min()
   max_date = viz_df[col].max()
   print(f"{col} range: {min_date} to {max_date}")
   
   # Identify any unusual dates (far in the future)
   future_cutoff = pd.Timestamp.now() + pd.DateOffset(years=50)
   far_future_mask = viz_df[col] > future_cutoff
   far_future_count = far_future_mask.sum()
   
   if far_future_count > 0:
       print(f"Found {far_future_count} dates in {col} that are more than 50 years in the future")
       # Flag these rows
       viz_df[f'{col}_Far_Future'] = far_future_mask

# Step 4: Calculate lease term for visualization
viz_df['Lease_Term_Years'] = (viz_df['Lease Expiry Date'] - viz_df['Lease Start Date']).dt.days / 365.25

# Identify unusually long lease terms
long_term_mask = viz_df['Lease_Term_Years'] > 50
long_term_count = long_term_mask.sum()

if long_term_count > 0:
   print(f"Found {long_term_count} leases with terms longer than 50 years")
   # Create a capped version for better visualization
   viz_df['Lease_Term_Years_Capped'] = viz_df['Lease_Term_Years'].clip(upper=30)
   print("Created capped lease term column for visualization (maximum 30 years)")
else:
   viz_df['Lease_Term_Years_Capped'] = viz_df['Lease_Term_Years']


# 4 Convert important columns to appropriate data types
