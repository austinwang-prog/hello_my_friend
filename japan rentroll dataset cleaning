print(f"Rows: {len(viz_df):,}")
print(f"Columns: {len(viz_df.columns)}")

print("\nFinal Column List:")
for i, col in enumerate(viz_df.columns, 1):
    print(f"{i}. {col}")

# Display data types and examples
print("\nColumn Types and Examples:")
for col in viz_df.columns:
    dtype = str(viz_df[col].dtype)  # Convert dtype to string
    sample = viz_df[col].iloc[0] if len(viz_df) > 0 else "N/A"
    null_pct = (viz_df[col].isnull().sum() / len(viz_df) * 100).round(2)
    
    # Format sample value based on dtype
    if pd.api.types.is_datetime64_any_dtype(viz_df[col]):
        sample = str(sample)[:10]  # Just date part for datetime
    elif pd.api.types.is_numeric_dtype(viz_df[col]):
        if pd.notnull(sample):
            try:
                sample = f"{float(sample):,.2f}"
            except:
                sample = str(sample)  # Fallback if formatting fails
        else:
            sample = "N/A"
    else:
        # Handle non-numeric, non-datetime types
        sample = str(sample)[:20] if pd.notnull(sample) else "N/A"
    
    # Use simpler string formatting to avoid issues
    print(f"{col:<25} | Type: {dtype:<15} | Example: {sample:<20} | Null: {null_pct}%")


