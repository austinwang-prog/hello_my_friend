    'Property Id',       
    'Unit Id',           
    'Contracted Rent Pa', 
    'Contracted Lettable Area Sqm', 
    'Lease Start Date', 
    'Lease Expiry Date'  
]

# Check availability and null percentages for critical columns
critical_availability = {}
for col in property_critical_columns:
    if col in cleaned_df.columns:
        if col in null_summary.index:
            null_pct = null_summary.loc[col, 'Null Percentage']
        else:
            null_pct = (cleaned_df[col].isnull().sum() / len(cleaned_df) * 100).round(2)
        critical_availability[col] = {
            'available': True,
            'null_percentage': null_pct
        }
    else:
        critical_availability[col] = {
            'available': False,
            'null_percentage': 100.0
        }

# Display critical column status
print("Status of critical property valuation columns:")
for col, status in critical_availability.items():
    if status['available']:
        print(f"- {col}: Available with {status['null_percentage']}% null values")
    else:
        print(f"- {col}: NOT AVAILABLE")
